{
	"name": "whiz",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"generate:catalogs": "node scripts/generate-catalogs.ts && prettier --write --log-level warn catalogs/*.json",
		"preview": "vite preview",
		"test:catalog-report": "node --test scripts/catalog-change-report.test.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@leftium/nimble.css": "^0.19.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"open-props": "^1.7.23",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"compromise": "^14.16.0",
		"compromise-dates": "^3.8.1",
		"compromise-stats": "^0.1.1",
		"fuzzysort": "^3.1.0",
		"svelte-inspect-value": "^0.11.3",
		"wellcrafted": "^0.43.0"
	}
}
